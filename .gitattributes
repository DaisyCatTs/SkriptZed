* text=auto eol=lf

# Skript is whitespace-significant; a CRLF sneaking into a fixture would change
# what the tests actually assert.
*.sk text eol=lf
*.scm text eol=lf
*.txt text eol=lf

# Generated by `tree-sitter generate` but committed on purpose: Zed compiles
# src/parser.c directly and never runs the CLI.
tree-sitter-skript/src/grammar.json    linguist-generated
tree-sitter-skript/src/node-types.json linguist-generated
tree-sitter-skript/src/parser.c        linguist-generated
tree-sitter-skript/src/tree_sitter/*   linguist-generated
