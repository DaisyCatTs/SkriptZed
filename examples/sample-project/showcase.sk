###
This file exists to be looked at, not run.

It has two jobs. It exercises every construct the extension claims to handle,
so opening it is a one-glance check that highlighting, indentation, folding and
the outline all behave. And it is a guided tour: the comments say what to try
where, so you can see each language-server feature working on real code.

  Hover              anything in a statement — `teleport`, `loop-player`,
                     `uuid of player` — for its description, syntax and
                     examples, straight from Skript's own database.
  Go to definition   F12 on `greet(...)` or `format_points(...)` in the
                     `on join:` block, or on `{@prefix}` anywhere. The second
                     reaches `library.sk`, which you have not opened.
  Find references    on `greet` — every call across the project.
  Rename             F2 on `{_name}` inside a function. The signature is
                     renamed too, and a `{_name}` in a different trigger is
                     left alone, because Skript scopes it per trigger.
  Completion         start typing `send`, `teleport` or `loop` on a new
                     indented line. The pattern shows beside the name.
  Signature help     type `greet(` and it shows the parameters.
  Inlay hints        both calls in `on join:` show parameter names inline.
  Outline            ⌘⇧O / Ctrl+Shift+O — commands nest their entries.
  Format             format the document; it re-indents from the parse tree
                     and refuses to touch a file that does not parse.
  Diagnostics        add a second `function greet(...)` and the error links
                     back to the first one.

If statements look uncoloured, `semantic_tokens` is still "off" — see step 2
of the README. That setting is what turns on classification.
###

# ---------------------------------------------------------------- structures
#
# The eight headers with a fixed shape. Every one of these folds, appears in
# the outline, and is understood by the grammar rather than by the server.

options:
	prefix: &6[Server]&r
	# An option's value is raw text, pasted in before parsing — it can hold code.
	is staff: player has permission "server.staff"

variables:
	{stats::joins} = 0
	{config::motd} = "Welcome!"

aliases:
	precious = diamond, emerald, netherite ingot

# ----------------------------------------------------------------- functions

# All three return markers are valid Skript. All three should highlight.
# Hover the parameter types; rename `{_name}` and watch the signature follow.
function greet(name: text) :: text:
	return "Hello, %{_name}%!"

function add_points(who: player, amount: number = 1) -> number:
	add {_amount} to {points::%{_who}%}
	return {points::%{_who}%}

local function internal_helper() returns boolean:
	# `local` means this is invisible to other scripts — go-to-definition from
	# another file must NOT find it, and neither must rename.
	return true

# ------------------------------------------------------------------ commands
#
# Fold this and the whole command collapses to one line. In the outline the
# entries nest underneath it. Every entry value below is highlighted as text,
# because that is what Skript treats it as.

command /home <text> [<text>]:
	description: Set, delete or travel to your home.
	usage: /home set/remove <name>, /home <name>
	permission: skript.home
	permission message: You cannot do that.
	aliases: /h
	executable by: players
	cooldown: 3 seconds
	cooldown message: Wait %remaining time%.
	trigger:
		if arg-1 is "set":
			set {homes::%uuid of player%::%arg-2%} to player's location
			send "{@prefix} Home &a%arg-2%&r saved." to player
		else if arg-1 is "remove":
			delete {homes::%uuid of player%::%arg-2%}
		else:
			teleport player to {homes::%uuid of player%::%arg-1%}

# -------------------------------------------------------------------- events

on join:
	add 1 to {stats::joins}
	# F12 here reaches greet() above; the call also carries an inlay hint.
	send greet(player's name) to player
	# And this one is declared in library.sk, which is not open.
	send format_points({stats::joins}) to player

on first join:
	broadcast "{@prefix} &e%player% joined for the first time!"

# Skript accepts a separator as space, hyphen or nothing, so all three of these
# are the same event. Hover each: every one resolves to On Click, not to the
# generic catch-all.
on right click:
	stop

on left-click on a sign:
	stop

on rightclick with a stick:
	stop

# The modifier follows `on`, and the priority follows the event name.
on cancelled damage with priority high:
	stop

# ------------------------------------------------------------ control flow

on quit:
	# Loops bind `loop-value`, `loop-index`, and typed forms like `loop-player`.
	loop all players:
		if loop-player has permission "server.staff":
			send "&7%player% left." to loop-player

	set {_items::*} to stone, oak planks and an apple
	loop {_items::*}:
		send "%loop-index%. %loop-value%"

	set {_n} to 0
	while {_n} < 3:
		add 1 to {_n}

	do while false is true:
		send "runs exactly once"

# ------------------------------------------------------- strings and colours

on chat:
	# Legacy `&6` codes, `<tag>` formats, hex colours, and `%interpolation%`.
	send "&6gold <red><bold>red bold<reset> <#FF00AA>hex %player%"
	# A `#` inside a string is literal — this whole line is one string, not a
	# comment, and a `:` inside it does not open a section. This is the single
	# most common thing other editors get wrong.
	send "Item #1 costs 5# and the ratio is 3:1"
	# Doubled quotes and doubled percent signs are the escapes.
	send "he said ""hi"" and took 50%% of it"
	# A variable name may contain a hash, and may nest another variable.
	set {count##} to 1
	set {_lookup::{_key}} to true

# --------------------------------------------------------- the #-# marker

on sneak toggle:
	# Without the marker, a trailing colon would open a section. With it, this
	# stays an ordinary statement and the next line does NOT indent. Press
	# Enter at the end of this line to see it.
	send "ratio 3:" to player #-#
	send "still in the same block"

# ----------------------------------------------------------------- literals

on world save:
	set {_number} to 42
	set {_decimal} to -2.5
	set {_flag} to true
	wait 5 seconds
	wait 1 tick
	set {_percent} to 50

on player join:
	send formatted "Hello" to player
	play sound "entity.player.levelup" with volume 1 and pitch 1 to player
