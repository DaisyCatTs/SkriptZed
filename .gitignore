# Rust
target/
**/target/

# Node
node_modules/

# Zed extension build artifacts. Zed clones and compiles the grammar here, and
# scripts/dev-setup.mjs does the same when Zed's wasi-sdk is installed.
extension/grammars/
extension/*.wasm

# tree-sitter build output (src/parser.c IS committed, see docs/grammar.md)
*.wasm
*.o
*.obj
*.so
*.dylib
*.dll
tree-sitter-skript/build/

# Third-party data, never committed: the upstream corpus for the corpus gate
# (scripts/parse-corpus.mjs prints the clone steps) and the GPL-3.0 docs.json /
# unlicensed SkriptHub catalog that scripts/fetch-*.mjs place for the tests.
vendor/

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini

# Local Zed settings. These point `lsp.skript-lsp.binary.path` at an absolute
# path on one machine, so they are per-developer rather than per-project.
# CONTRIBUTING.md shows what to put here.
.zed/

# Local tooling and editor config
.claude/

# Generated by scripts/make-test-server.mjs — stub plugin JARs so addon syntax
# can be exercised without owning a server. Rebuilt in under a second.
examples/sample-project/test-server/

# A scratch file for trying things in the editor without dirtying the repo.
examples/sample-project/scratch.sk
